# Local MongoDB replica set (required for atomic inventory transactions)
MONGODB_URI=mongodb://127.0.0.1:27018/suwasetha_inventory?replicaSet=rs0
API_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-strong-temporary-password
ADMIN_NAME=System Administrator

VITE_API_URL=/api
VITE_APP_NAME=Suwasetha Indigenous Medicine Hospital
VITE_DEFAULT_LOCALE=en
VITE_TIMEZONE=Asia/Colombo

# Server-side notification settings (never prefix secrets with VITE_)
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_REPLY_TO=
ALERT_RECIPIENTS=
APP_BASE_URL=http://localhost:5173
